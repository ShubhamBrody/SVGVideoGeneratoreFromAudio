# ---- LLM provider: auto | openai | ollama | mock ----
# "auto" picks the first configured provider, falling back to the offline mock.
# For fully local, no-key AI, install Ollama (https://ollama.com), run `ollama serve`,
# `ollama pull qwen2.5-coder:1.5b`, and set LLM_PROVIDER=ollama below.
LLM_PROVIDER=auto

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ---- Ollama (local, no API key) ----
# qwen2.5-coder:7b = best quality (~35s/scene on a 16GB GPU).
# qwen2.5-coder:1.5b = much faster (~8s/scene) with slightly simpler scenes.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# ---- Whisper speech-to-text ----
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ---- Server ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSETS_DIR=assets
MAX_UPLOAD_MB=25
