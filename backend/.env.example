# ---- LLM provider: auto | openai | ollama | mock ----
# "auto" picks the first configured provider, falling back to the offline mock.
LLM_PROVIDER=auto

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ---- Ollama (local) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder

LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# ---- Whisper speech-to-text ----
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ---- Server ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSETS_DIR=assets
MAX_UPLOAD_MB=25
